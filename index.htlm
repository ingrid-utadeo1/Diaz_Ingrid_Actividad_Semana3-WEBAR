<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Mombo | Cartera de hombro versátil</title>

  <!-- Model Viewer: visualización 3D + Realidad Aumentada -->
  <script type="module"
    src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js">
  </script>

  <!-- Generador de QR -->
  <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>

  <style>
    :root {
      --brown-dark: #3d2920;
      --brown: #70503d;
      --brown-light: #a77b5a;
      --beige: #eadbc8;
      --cream: #faf7f2;
      --white: #ffffff;
      --text: #342821;
      --green: #526b58;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: var(--text);
      background: var(--cream);
    }

    /* ================= HEADER ================= */

    header {
      background: var(--white);
      border-bottom: 1px solid #eee3d7;
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .navbar {
      max-width: 1180px;
      margin: auto;
      padding: 18px 25px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 28px;
      font-weight: 800;
      letter-spacing: 4px;
      color: var(--brown-dark);
    }

    .nav-link {
      text-decoration: none;
      color: var(--brown-dark);
      font-weight: 600;
    }

    /* ================= HERO ================= */

    .hero {
      min-height: 680px;
      background:
        radial-gradient(circle at 80% 20%, #eadbc8 0%, transparent 35%),
        linear-gradient(135deg, #faf7f2 0%, #f0e4d5 100%);
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 50px;
      padding: 70px 6%;
    }

    .hero-text {
      max-width: 570px;
    }

    .eyebrow {
      color: var(--brown);
      font-size: 14px;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 15px;
    }

    .hero h1 {
      font-family: Georgia, serif;
      font-size: clamp(42px, 5vw, 70px);
      line-height: 1.02;
      color: var(--brown-dark);
      margin-bottom: 20px;
    }

    .hero h1 span {
      color: var(--brown-light);
    }

    .hero-description {
      font-size: 18px;
      line-height: 1.7;
      color: #66564c;
      margin-bottom: 25px;
      max-width: 500px;
    }

    /* ================= PRICE ================= */

    .price-card {
      background: rgba(255,255,255,.75);
      border: 1px solid #e2d2c1;
      border-radius: 18px;
      padding: 20px;
      max-width: 430px;
      margin-bottom: 25px;
    }

    .price-label {
      font-size: 13px;
      color: #7d6c61;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .old-price {
      color: #8b817b;
      text-decoration: line-through;
      font-size: 18px;
      margin-top: 5px;
    }

    .new-price {
      color: var(--brown-dark);
      font-size: 34px;
      font-weight: 800;
      margin-top: 2px;
    }

    .saving {
      color: var(--green);
      font-weight: bold;
      margin-top: 4px;
    }

    /* ================= BUTTONS ================= */

    .buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .btn {
      border: none;
      border-radius: 50px;
      padding: 15px 25px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: .25s ease;
    }

    .btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 20px rgba(61,41,32,.18);
    }

    .btn-buy {
      background: var(--brown-dark);
      color: white;
    }

    .btn-ar {
      background: var(--brown-light);
      color: white;
    }

    /* ================= 3D ================= */

    .product-view {
      background: rgba(255,255,255,.7);
      border: 1px solid #e4d6c7;
      border-radius: 28px;
      padding: 15px;
      box-shadow: 0 25px 60px rgba(61,41,32,.13);
    }

    model-viewer {
      width: 100%;
      height: 540px;
      border-radius: 20px;
      background:
        radial-gradient(circle at center, #f8f0e6 0%, #e6d5c1 100%);
    }

    .viewer-help {
      text-align: center;
      padding: 12px 5px 5px;
      color: #75665c;
      font-size: 13px;
    }

    /* ================= BENEFITS ================= */

    .benefits-section {
      background: white;
      padding: 80px 6%;
      text-align: center;
    }

    .section-title {
      font-family: Georgia, serif;
      font-size: 40px;
      color: var(--brown-dark);
      margin-bottom: 12px;
    }

    .section-subtitle {
      color: #75665c;
      max-width: 650px;
      margin: auto;
    }

    .benefits {
      max-width: 1100px;
      margin: 45px auto 0;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .benefit {
      padding: 35px 25px;
      background: var(--cream);
      border-radius: 20px;
    }

    .benefit-icon {
      font-size: 35px;
      margin-bottom: 15px;
    }

    .benefit h3 {
      color: var(--brown-dark);
      margin-bottom: 10px;
    }

    .benefit p {
      color: #716259;
      line-height: 1.6;
    }

    /* ================= PRODUCT INFO ================= */

    .product-info {
      padding: 80px 6%;
      background: var(--beige);
    }

    .info-container {
      max-width: 1050px;
      margin: auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      align-items: center;
    }

    .info-container h2 {
      font-family: Georgia, serif;
      font-size: 42px;
      color: var(--brown-dark);
      margin-bottom: 20px;
    }

    .info-container p {
      line-height: 1.8;
      color: #5f5047;
      margin-bottom: 20px;
    }

    .features {
      list-style: none;
    }

    .features li {
      margin: 13px 0;
      font-weight: 600;
    }

    .features li::before {
      content: "✓";
      color: var(--green);
      margin-right: 10px;
      font-weight: bold;
    }

    .price-highlight {
      background: var(--brown-dark);
      color: white;
      padding: 35px;
      border-radius: 25px;
      text-align: center;
    }

    .price-highlight small {
      color: #d8c7b6;
    }

    .price-highlight strong {
      display: block;
      font-size: 38px;
      margin: 10px 0;
    }

    /* ================= QR ================= */

    .qr-section {
      padding: 80px 20px;
      background: white;
      text-align: center;
    }

    #qrcode {
      width: 190px;
      height: 190px;
      margin: 30px auto;
      padding: 10px;
      background: white;
      border: 1px solid #eee;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .qr-note {
      color: #777;
      font-size: 14px;
    }

    /* ================= FOOTER ================= */

    footer {
      background: var(--brown-dark);
      color: white;
      padding: 45px 20px;
      text-align: center;
    }

    footer .footer-logo {
      font-size: 25px;
      font-weight: bold;
      letter-spacing: 4px;
      margin-bottom: 15px;
    }

    footer p {
      color: #d9c8b8;
      margin: 8px;
    }

    footer a {
      color: white;
    }

    /* ================= RESPONSIVE ================= */

    @media (max-width: 850px) {

      .hero {
        grid-template-columns: 1fr;
        padding: 50px 20px;
      }

      .hero-text {
        text-align: center;
        margin: auto;
      }

      .hero-description {
        margin-left: auto;
        margin-right: auto;
      }

      .price-card {
        margin-left: auto;
        margin-right: auto;
        text-align: left;
      }

      .buttons {
        justify-content: center;
      }

      .benefits {
        grid-template-columns: 1fr;
        max-width: 500px;
      }

      .info-container {
        grid-template-columns: 1fr;
      }

      model-viewer {
        height: 450px;
      }
    }

    @media (max-width: 500px) {

      .navbar {
        padding: 15px 18px;
      }

      .nav-link {
        font-size: 14px;
      }

      .hero {
        padding-top: 35px;
      }

      .hero h1 {
        font-size: 43px;
      }

      .section-title {
        font-size: 32px;
      }

      .info-container h2 {
        font-size: 32px;
      }

      model-viewer {
        height: 380px;
      }

      .btn {
        width: 100%;
        text-align: center;
      }
    }
  </style>
</head>

<body>

  <!-- ================= HEADER ================= -->

  <header>
    <nav class="navbar">
      <div class="logo">MOMBO</div>

      <a
        class="nav-link"
        href="#producto">
        Nuestra cartera
      </a>
    </nav>
  </header>


  <!-- ================= HERO ================= -->

  <main>

    <section class="hero" id="producto">

      <div class="hero-text">

        <div class="eyebrow">
          Nueva colección · Mombo
        </div>

        <h1>
          Tu estilo,<br>
          <span>en movimiento.</span>
        </h1>

        <p class="hero-description">
          Conoce nuestra cartera de hombro versátil:
          un diseño pensado para acompañarte todos los días,
          combinar con diferentes estilos y mantener tus
          objetos organizados.
        </p>

        <!-- ANCLAJE DE PRECIO -->

        <div class="price-card">

          <div class="price-label">
            Oferta especial
          </div>

          <div class="old-price">
            Precio antes: $370.000 COP
          </div>

          <div class="new-price">
            Hoy $330.000 COP
          </div>

          <div class="saving">
            Ahorras $40.000 COP
          </div>

        </div>

        <div class="buttons">

          <!-- CTA PRINCIPAL -->

          <a
            class="btn btn-buy"
            href="https://parchita.com.co/collections/bolsos-para-mujer/products/cartera-tat?variant=51327974408470"
            target="_blank"
            rel="noopener noreferrer">
            Comprar ahora
          </a>

          <!-- CTA DE REALIDAD AUMENTADA -->

          <button
            class="btn btn-ar"
            onclick="abrirAR()">
            Ver en mi espacio
          </button>

        </div>

      </div>


      <!-- ================= VISOR 3D ================= -->

      <div class="product-view">

        <model-viewer
          id="momboModel"
          src="modelo.glb"
          alt="Cartera de hombro versátil Mombo"
          camera-controls
          touch-action="pan-y"
          auto-rotate
          rotation-per-second="25deg"
          shadow-intensity="1"
          exposure="1"
          ar
          ar-modes="webxr scene-viewer quick-look">

        </model-viewer>

        <div class="viewer-help">
          Arrastra para girar · Usa los controles para explorar el producto
        </div>

      </div>

    </section>


    <!-- ================= BENEFICIOS ================= -->

    <section class="benefits-section">

      <h2 class="section-title">
        Diseñada para acompañarte
      </h2>

      <p class="section-subtitle">
        Una cartera que combina funcionalidad,
        versatilidad y un estilo fácil de llevar.
      </p>

      <div class="benefits">

        <article class="benefit">

          <div class="benefit-icon">✦</div>

          <h3>Versátil</h3>

          <p>
            Su diseño permite utilizarla en diferentes
            momentos y combinarla con distintos estilos.
          </p>

        </article>


        <article class="benefit">

          <div class="benefit-icon">◈</div>

          <h3>Organizada</h3>

          <p>
            Cuenta con compartimientos internos para
            ayudarte a mantener tus objetos en orden.
          </p>

        </article>


        <article class="benefit">

          <div class="benefit-icon">♡</div>

          <h3>Estilo atemporal</h3>

          <p>
            Su tono café aporta una apariencia cálida,
            elegante y fácil de combinar.
          </p>

        </article>

      </div>

    </section>


    <!-- ================= INFORMACIÓN ================= -->

    <section class="product-info">

      <div class="info-container">

        <div>

          <h2>
            Una cartera para todos tus días
          </h2>

          <p>
            La propuesta de Mombo busca ofrecer una pieza
            práctica y versátil para mujeres entre 15 y 50 años,
            combinando diseño y funcionalidad.
          </p>

          <ul class="features">

            <li>Color café</li>

            <li>Diseño de hombro</li>

            <li>Tamaño promedio</li>

            <li>Compartimientos internos</li>

            <li>Modelo 3D interactivo</li>

          </ul>

        </div>


        <div class="price-highlight">

          <small>
            PRECIO ESPECIAL
          </small>

          <strong>
            $330.000
          </strong>

          <p>
            COP
          </p>

          <br>

          <small>
            Antes $370.000 COP
          </small>

        </div>

      </div>

    </section>


    <!-- ================= QR ================= -->

    <section class="qr-section">

      <h2 class="section-title">
        Llévala a tu espacio
      </h2>

      <p>
        Cuando publiques esta página, podrás escanear
        este código desde tu celular para acceder a la
        experiencia WebAR.
      </p>

      <div id="qrcode"></div>

      <p class="qr-note">
        El código se actualizará automáticamente con la
        URL pública de la página.
      </p>

    </section>

  </main>


  <!-- ================= FOOTER ================= -->

  <footer>

    <div class="footer-logo">
      MOMBO
    </div>

    <p>
      Cartera de hombro versátil
    </p>

    <p>
      Contacto:
      <a href="mailto:ingrid.utadeo1@gmail.com">
        ingrid.utadeo1@gmail.com
      </a>
    </p>

  </footer>


  <!-- ================= JAVASCRIPT ================= -->

  <script>

    /*
      BOTÓN DE REALIDAD AUMENTADA
    */

    async function abrirAR() {

      const modelo = document.getElementById("momboModel");

      try {

        if (modelo.canActivateAR) {

          await modelo.activateAR();

        } else {

          alert(
            "La Realidad Aumentada debe probarse desde un celular compatible y mediante una URL HTTPS."
          );

        }

      } catch (error) {

        console.error("Error al activar RA:", error);

        alert(
          "No fue posible activar la Realidad Aumentada en este dispositivo."
        );

      }

    }


    /*
      CÓDIGO QR

      window.location.href permite que el QR utilice
      automáticamente la URL de la página publicada.

      Mientras trabajamos en localhost, el QR apunta
      a localhost. Después de publicar en GitHub Pages,
      apuntará automáticamente a la URL pública.
    */

    window.addEventListener("load", function () {

      const qrContainer = document.getElementById("qrcode");

      qrContainer.innerHTML = "";

      new QRCode(qrContainer, {
        text: window.location.href,
        width: 160,
        height: 160,
        colorDark: "#3d2920",
        colorLight: "#ffffff",
        correctLevel: QRCode.CorrectLevel.H
      });

    });

  </script>

</body>
</html>
